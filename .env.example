# =============================================================================
# Jarvis CLIMAT-SEN - variables d'environnement
# =============================================================================
# Copier en .env et renseigner. Le fichier .env est deja ignore par git
# (voir .gitignore) : ne JAMAIS l'y ajouter.
#
# Generer une cle de signature :
#   py -3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- Secrets (obligatoires en production) -----------------------------------
ANTHROPIC_API_KEY=
# A renseigner UNIQUEMENT si la cle ci-dessus n est pas rattachee a un workspace.
# Symptome : erreur 400 "This API key is not scoped to a workspace".
# Alternative plus simple : creer une cle deja scopee a un workspace.
ANTHROPIC_WORKSPACE_ID=
JARVIS_SECRET_KEY=

# --- Environnement -----------------------------------------------------------
# dev  : cle de signature ephemere toleree, /jarvis/docs expose
# prod : secrets obligatoires, documentation d'API fermee
JARVIS_ENV=dev

# --- Modeles ------------------------------------------------------------------
JARVIS_MODEL_PUBLIC=claude-sonnet-5
JARVIS_MODEL_ADMIN=claude-opus-5
JARVIS_EFFORT_PUBLIC=low
JARVIS_THINKING_PUBLIC=adaptive
JARVIS_MAX_TOKENS_PUBLIC=2048

# --- Robustesse ------------------------------------------------------------------
JARVIS_REQUEST_TIMEOUT_SECONDS=60
JARVIS_MAX_RETRIES=2

# --- Outils de lecture des donnees (Phase 2) ----------------------------------
# off : Jarvis repond sans acceder aux donnees (repli si un jeu devient
#       illisible en production). Le prompt lui interdit alors tout chiffre.
JARVIS_TOOLS_ENABLED=true
# Tours d'outils autorises avant de forcer une reponse en texte. Chaque tour
# est un appel API de plus : c'est le garde-fou de cout.
JARVIS_MAX_TOOL_ROUNDS=3
# Plafond de taille d'un resultat d'outil injecte dans le contexte.
JARVIS_TOOL_RESULT_MAX_CHARS=6000
# Prechauffe les loaders au demarrage (3 a 4 s, en tache de fond) pour que le
# premier visiteur ne paie pas la lecture des CSV.
JARVIS_TOOLS_PRELOAD=true

# --- Plafonds conversation (maitrise du cout) -------------------------------------
JARVIS_SESSION_TTL_SECONDS=86400
JARVIS_CONVERSATION_TTL_SECONDS=7200
JARVIS_MAX_TURNS=20
JARVIS_MAX_MESSAGE_CHARS=4000
JARVIS_MAX_HISTORY_CHARS=60000

# --- Rate limiting public ----------------------------------------------------------
JARVIS_RATE_LIMIT_CAPACITY=12
JARVIS_RATE_LIMIT_REFILL_PER_MINUTE=6

# --- Reseau ---------------------------------------------------------------------------
# En production, widget et backend sont derriere le meme nginx : le CORS ne sert
# qu'au developpement local (Streamlit 8501 -> Jarvis 8000).
JARVIS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Logs -------------------------------------------------------------------------------
JARVIS_LOG_PROMPTS=true
JARVIS_LOG_PREVIEW_CHARS=200

# --- Widget -------------------------------------------------------------------------------
# Base d'API vue par le navigateur. Vide en production (meme origine : /jarvis).
JARVIS_WIDGET_API_BASE=http://localhost:8000/jarvis

# --- Widget ---------------------------------------------------------------
# Mettre "off" pour retirer la bulle Jarvis du dashboard sans toucher au code.
JARVIS_WIDGET=on
# Mode d affichage du panneau : "pousse" (defaut, decale le contenu du
# dashboard pour ne rien recouvrir) ou "flottant" (se superpose au contenu).
JARVIS_WIDGET_MODE=pousse
