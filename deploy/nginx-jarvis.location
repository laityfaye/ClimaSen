# Bloc a inserer dans le server{} HTTPS de nginx-climatsen.conf,
# AVANT le "location /" du dashboard (nginx choisit le prefixe le plus long,
# mais l'ordre reste plus lisible ainsi).
#
# Pas de slash final sur proxy_pass : le prefixe /jarvis est conserve et
# transmis tel quel a FastAPI, dont toutes les routes commencent par /jarvis.

location /jarvis/ {
    # Le serveur autorise 500 Mo pour le dashboard; Jarvis n'en a pas
    # besoin. Une question avec captures de graphiques pese ~1,3 Mo
    # (Phase 9); l'application refuse aussi au-dela de 2,5 Mo.
    client_max_body_size 3m;
    proxy_pass         http://127.0.0.1:8000;
    proxy_http_version 1.1;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # INDISPENSABLE pour le streaming SSE : sans cela nginx accumule la reponse
    # et la delivre d'un bloc a la fin, ce qui annule l'effet de streaming.
    proxy_buffering    off;
    proxy_cache        off;
    chunked_transfer_encoding on;

    # Une reponse peut prendre quelques dizaines de secondes.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}
