[Unit]
Description=ClimaSen - Dashboard Precipitations Extremes Senegal
After=network.target

[Service]
User=climatsen
Group=climatsen
WorkingDirectory=/home/climatsen/app
Environment="PATH=/home/climatsen/app/venv/bin"
ExecStart=/home/climatsen/app/venv/bin/streamlit run scripts/dashboard.py --server.port=8501 --server.headless=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
